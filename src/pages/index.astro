---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((project) => project.data.featured);
---

<BaseLayout title="Willing Studio · 作品档案" description="关注影像、交互与视觉实验的匿名作品档案。">
  <main>
    <section class="hero shell" id="top">
      <div class="hero-copy">
        <p class="eyebrow">SELECTED WORKS · 2026</p>
        <h1>把想法做成<br /><span>可以观看的作品。</span></h1>
        <p class="intro">这里记录影像、交互与视觉实验。只展示作品本身，不陈列不必要的个人信息。</p>
        <div class="hero-actions">
          <a class="button primary" href="#works">浏览作品</a>
          <a class="button ghost" href="#archive">查看索引</a>
        </div>
      </div>

      <div class="stage" aria-label="抽象几何创作展台">
        <div class="stage-panel"></div>
        <div class="stage-lines" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
        <div class="stage-ball small"></div><div class="stage-ball large"></div>
        <div class="stage-block"></div><div class="stage-base"></div>
        <span>WORK / 001</span>
      </div>
    </section>

    <div class="ticker" aria-label="作品分类">
      <span>影像</span><b>✦</b><span>交互</span><b>✦</b><span>视觉实验</span><b>✦</b>
      <span>代码</span><b>✦</b><span>声音</span><b>✦</b><span>过程记录</span>
    </div>

    <section class="works shell" id="works">
      <header class="section-head">
        <div><p class="eyebrow">FEATURED PROJECTS</p><h2>精选作品</h2></div>
        <p>每个项目均可包含图集、视频、创作说明、在线演示与源码地址。</p>
      </header>
      <div class="project-grid">
        {featured.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
    </section>

    <section class="archive shell" id="archive">
      <header class="section-head compact">
        <div><p class="eyebrow">PROJECT INDEX</p><h2>作品索引</h2></div>
        <span class="count">{String(projects.length).padStart(2, '0')} 件作品</span>
      </header>
      <div class="archive-list">
        {projects.map((project, index) => (
          <a href={`/projects/${project.id}/`} class="archive-row">
            <span>{String(index + 1).padStart(2, '0')}</span><strong>{project.data.title}</strong>
            <span>{project.data.type}</span><span>{project.data.year}</span><b>↗</b>
          </a>
        ))}
      </div>
    </section>

    <section class="privacy shell">
      <div>
        <p class="eyebrow">ABOUT THIS ARCHIVE</p>
        <h2>作品在前，身份信息在后。</h2>
        <p>本站默认不公开真实姓名、学校、住址和私人联系方式。需要合作时，可在具体项目中提供单独的公开联系渠道。</p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(380px,.9fr);gap:clamp(3rem,8vw,8rem);align-items:center;min-height:760px;padding-block:7rem 5rem}
  .hero h1{max-width:780px;margin:1rem 0 1.5rem;font-size:clamp(3.6rem,7vw,7.6rem);font-weight:680;letter-spacing:-.075em;line-height:.95}.hero h1 span{color:var(--blue)}
  .intro{max-width:620px;color:var(--ink-soft);font-size:clamp(1rem,1.3vw,1.2rem);line-height:1.9}.hero-actions{display:flex;gap:.8rem;margin-top:2.25rem}
  .stage{position:relative;min-height:490px;overflow:hidden;border:1px solid var(--line);border-radius:2.5rem;background:linear-gradient(145deg,#a8e4e8,#d8f5f3 62%,#fdf7f3);box-shadow:0 35px 90px rgba(60,130,140,.22);isolation:isolate}
  .stage:after{position:absolute;inset:0;background:linear-gradient(115deg,rgba(255,255,255,.45),transparent 38%);content:''}.stage-panel,.stage-lines,.stage-ball,.stage-block,.stage-base{position:absolute;filter:drop-shadow(0 22px 20px rgba(43,102,112,.18))}
  .stage-panel{left:16%;bottom:24%;width:45%;height:45%;background:#b9e9eb}.stage-lines{right:24%;bottom:24%;display:flex;gap:11px;width:34%;height:62%}.stage-lines i{display:block;flex:1;background:#fff6f2}
  .stage-ball{border-radius:50%;background:#9ddde2}.stage-ball.small{left:29%;bottom:23%;width:68px;height:68px}.stage-ball.large{right:10%;bottom:19%;width:155px;height:155px}.stage-block{left:39%;bottom:17%;width:105px;height:58px;background:#b3e5e6}.stage-base{left:10%;right:7%;bottom:10%;height:58px;background:#fffaf7}
  .stage>span{position:absolute;top:1.25rem;right:1.4rem;z-index:2;padding:.55rem .8rem;border:1px solid var(--line);border-radius:99px;background:rgba(255,255,255,.62);font:650 .7rem/1 var(--mono);letter-spacing:.12em}
  .ticker{display:flex;justify-content:center;gap:clamp(1rem,3vw,3rem);overflow:hidden;padding:1.1rem 2rem;border-block:1px solid var(--line);color:var(--ink-soft);font-size:.82rem;letter-spacing:.18em;white-space:nowrap}.ticker b{color:var(--coral)}
  .works,.archive,.privacy{padding-block:7.5rem}.section-head{display:flex;justify-content:space-between;gap:2rem;align-items:end;margin-bottom:3rem}.section-head h2,.privacy h2{margin:.35rem 0 0;font-size:clamp(2.5rem,4vw,4.7rem);letter-spacing:-.055em}.section-head>p{max-width:490px;color:var(--ink-soft);line-height:1.8}
  .project-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:1.25rem}.project-grid>:global(a){grid-column:span 6}.project-grid>:global(a:first-child){grid-column:span 7}.project-grid>:global(a:nth-child(2)){grid-column:span 5}
  .archive{border-top:1px solid var(--line)}.compact{margin-bottom:2rem}.count{color:var(--ink-soft);font: .78rem/1 var(--mono)}.archive-list{border-top:1px solid var(--line)}
  .archive-row{display:grid;grid-template-columns:55px minmax(0,1fr) minmax(100px,.35fr) 70px 28px;gap:1rem;align-items:center;padding:1.45rem 0;border-bottom:1px solid var(--line);color:inherit;text-decoration:none;transition:.2s}.archive-row:hover{padding-inline:.6rem;color:var(--blue-deep)}.archive-row span{color:var(--ink-soft);font:.75rem/1.3 var(--mono)}.archive-row b{color:var(--coral)}
  .privacy>div{padding:clamp(2.2rem,6vw,6rem);border-radius:2.5rem;background:var(--ink);color:#fff;box-shadow:0 30px 80px rgba(24,46,53,.16)}.privacy .eyebrow{color:#9ddfe1}.privacy div>p:last-child{max-width:720px;color:rgba(255,255,255,.68);line-height:1.9}
  @media(max-width:860px){.hero{grid-template-columns:1fr;min-height:auto;padding-top:5rem}.stage{min-height:420px}.project-grid>:global(a){grid-column:1/-1!important}.section-head{display:block}.section-head>p{margin-top:1rem}}
  @media(max-width:600px){.hero{padding-top:3.5rem}.hero h1{font-size:3.25rem}.stage{min-height:340px;border-radius:1.8rem}.stage-ball.large{width:110px;height:110px}.archive-row{grid-template-columns:38px 1fr 28px}.archive-row span:nth-of-type(n+2){display:none}}
</style>
