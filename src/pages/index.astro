---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout title="Willingsoon — 作品档案">
  <div class="workspace">
    <aside class="sidebar">
      <div>
        <a class="brand" href="/">
          <img
            class="brand-avatar"
            src="/media/avatar.jpg"
            alt="Willingsoon头像"
          />
          <strong>WILLINGSOON</strong>
        </a>

        <nav>
          <a class="active" href="#overview">
            <span>◉</span> 概览
          </a>

          <a href="#projects">
            <span>▣</span> 精选作品
          </a>

          <a href="#index">
            <span>☷</span> 项目索引
          </a>
        </nav>
      </div>

      <div class="side-bottom">
        <p><i></i> AVAILABLE</p>

        <a
          href="https://github.com/willingsoon"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub ↗
        </a>
      </div>
    </aside>

    <main class="dashboard">
      <header class="topbar">
        <div>
          <p>PROJECT ARCHIVE / 2026</p>
          <h1>作品档案</h1>
        </div>

        <span>
          {String(projects.length).padStart(2, '0')} PROJECTS
        </span>
      </header>

      <section class="overview" id="overview">
        <div>
          <p class="label">OVERVIEW</p>
          <h2>视觉、影像与交互实验。</h2>
          <p class="description">
            一个专注于项目过程与最终成果的个人作品档案。
          </p>
        </div>

        <div class="overview-art" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
        </div>
      </section>

      <section class="projects" id="projects">
        <div class="section-title">
          <h2>精选作品</h2>
          <span>SELECTED WORKS</span>
        </div>

        <div class="project-grid">
          {
            projects.slice(0, 4).map((project, index) => (
              <article class="project-card">
                <a
                  class="project-visual"
                  href={`/projects/${project.id}/`}
                  style={`--accent:${project.data.accent}`}
                >
                  {
                    project.data.cover ? (
                      <img
                        src={project.data.cover}
                        alt={`${project.data.title}项目封面`}
                      />
                    ) : (
                      <div class={`art art-${(index % 3) + 1}`}>
                        <i></i>
                        <i></i>
                        <i></i>
                      </div>
                    )
                  }

                  <span>0{index + 1}</span>
                </a>

                <div class="project-info">
                  <div>
                    <p>
                      {project.data.type} · {project.data.year}
                    </p>

                    <h3>
                      <a href={`/projects/${project.id}/`}>
                        {project.data.title}
                      </a>
                    </h3>
                  </div>

                  <a
                    class="open"
                    href={`/projects/${project.id}/`}
                    aria-label={`查看${project.data.title}`}
                  >
                    ↗
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="project-index" id="index">
        <div class="section-title">
          <h2>项目索引</h2>
          <span>ALL PROJECTS</span>
        </div>

        <div class="index-list">
          {
            projects.map((project, index) => (
              <a href={`/projects/${project.id}/`}>
                <span>
                  {String(index + 1).padStart(2, '0')}
                </span>

                <strong>{project.data.title}</strong>
                <span>{project.data.type}</span>
                <span>{project.data.year}</span>
                <b>↗</b>
              </a>
            ))
          }
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<style is:global>
  .site-header,
  .site-footer {
    display: none;
  }

  body {
    overflow: hidden;
    background: #f6f7f8;
  }

  .workspace {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
  }

  .sidebar {
    height: 100vh;
    padding: 26px 18px;
    border-right: 1px solid #d8dee4;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: #ffffff;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #24292f;
    font: 700 0.78rem/1 var(--mono);
    letter-spacing: 0.08em;
  }

  .brand-avatar {
    width: 42px;
    height: 42px;
    flex: 0 0 auto;
    border: 1px solid #d0d7de;
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
  }

  .sidebar nav {
    margin-top: 42px;
    display: grid;
    gap: 5px;
  }

  .sidebar nav a {
    padding: 11px 12px;
    border-radius: 7px;
    display: flex;
    align-items: center;
    gap: 10px;
    color: #57606a;
    font-size: 0.84rem;
  }

  .sidebar nav a span {
    width: 18px;
    color: #6e7781;
    text-align: center;
  }

  .sidebar nav a:hover,
  .sidebar nav a.active {
    color: #24292f;
    background: #f0f3f6;
  }

  .side-bottom {
    display: grid;
    gap: 12px;
    font: 0.7rem/1 var(--mono);
  }

  .side-bottom p {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    color: #57606a;
  }

  .side-bottom i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #2da44e;
    box-shadow: 0 0 0 4px rgba(45, 164, 78, 0.1);
  }

  .side-bottom a {
    color: #0969da;
  }

  .dashboard {
    height: 100vh;
    min-width: 0;
    overflow: hidden;
    padding: 20px 26px;
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr) auto;
    gap: 14px;
  }

  .topbar,
  .section-title,
  .project-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .topbar {
    min-height: 52px;
  }

  .topbar p,
  .topbar > span,
  .section-title span,
  .project-info p {
    margin: 0;
    color: #6e7781;
    font: 0.66rem/1 var(--mono);
    letter-spacing: 0.07em;
  }

  .topbar h1 {
    margin: 5px 0 0;
    color: #24292f;
    font-size: 1.5rem;
    letter-spacing: -0.04em;
  }

  .topbar > span {
    padding: 7px 10px;
    border: 1px solid #d0d7de;
    border-radius: 999px;
    background: white;
  }

  .overview {
    min-height: 116px;
    padding: 17px 20px;
    border: 1px solid #d0d7de;
    border-radius: 12px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 230px;
    align-items: center;
    gap: 24px;
    overflow: hidden;
    background: white;
  }

  .label {
    margin: 0 0 8px;
    color: #0969da;
    font: 700 0.64rem/1 var(--mono);
  }

  .overview h2 {
    margin: 0;
    color: #24292f;
    font-size: clamp(1.35rem, 2.4vw, 2.15rem);
    letter-spacing: -0.045em;
  }

  .description {
    margin: 8px 0 0;
    color: #6e7781;
    font-size: 0.82rem;
  }

  .overview-art {
    position: relative;
    height: 82px;
    overflow: hidden;
    border-radius: 9px;
    background: var(--aqua);
  }

  .overview-art i {
    position: absolute;
    display: block;
    background: #fffaf6;
    box-shadow: 8px 10px 18px rgba(25, 48, 57, 0.12);
  }

  .overview-art i:nth-child(1) {
    width: 72px;
    height: 54px;
    left: 28px;
    bottom: 14px;
  }

  .overview-art i:nth-child(2) {
    width: 50px;
    height: 50px;
    top: 16px;
    right: 34px;
    border-radius: 50%;
  }

  .overview-art i:nth-child(3) {
    width: 130px;
    height: 11px;
    right: 18px;
    bottom: 10px;
  }

  .projects {
    min-height: 0;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 9px;
  }

  .section-title h2 {
    margin: 0;
    color: #24292f;
    font-size: 0.94rem;
  }

  .project-grid {
    min-height: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .project-card {
    min-width: 0;
    min-height: 0;
    padding: 10px;
    border: 1px solid #d0d7de;
    border-radius: 12px;
    display: grid;
    grid-template-rows: minmax(115px, 1fr) auto;
    gap: 9px;
    background: white;
  }

  .project-visual {
    position: relative;
    min-height: 0;
    overflow: hidden;
    border-radius: 8px;
    background: var(--accent);
  }

  .project-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-visual > span {
    position: absolute;
    top: 10px;
    right: 10px;
    color: #24292f;
    font: 700 0.64rem/1 var(--mono);
  }

  .art,
  .art i {
    position: absolute;
  }

  .art {
    inset: 0;
  }

  .art i {
    display: block;
    background: #fffaf6;
    box-shadow: 10px 12px 22px rgba(25, 48, 57, 0.14);
  }

  .art i:nth-child(1) {
    width: 35%;
    height: 55%;
    left: 18%;
    top: 20%;
    transform: rotate(-5deg);
  }

  .art i:nth-child(2) {
    width: 24%;
    aspect-ratio: 1;
    right: 16%;
    top: 20%;
    border-radius: 50%;
  }

  .art i:nth-child(3) {
    width: 48%;
    height: 12%;
    right: 12%;
    bottom: 17%;
  }

  .art-2 i:nth-child(2) {
    background: var(--coral);
  }

  .project-info h3 {
    margin: 5px 0 0;
    color: #24292f;
    font-size: 1rem;
  }

  .open {
    width: 30px;
    height: 30px;
    border: 1px solid #d0d7de;
    border-radius: 7px;
    display: grid;
    place-items: center;
    color: #0969da;
  }

  .project-index {
    display: grid;
    gap: 7px;
  }

  .index-list {
    border: 1px solid #d0d7de;
    border-radius: 10px;
    overflow: hidden;
    background: white;
  }

  .index-list a {
    min-height: 34px;
    padding: 0 12px;
    display: grid;
    grid-template-columns: 36px 1fr 140px 55px 20px;
    gap: 10px;
    align-items: center;
    border-bottom: 1px solid #d8dee4;
    color: #24292f;
    font-size: 0.74rem;
  }

  .index-list a:last-child {
    border-bottom: 0;
  }

  .index-list a:hover {
    background: #f6f8fa;
  }

  .index-list span {
    color: #6e7781;
    font: 0.65rem/1 var(--mono);
  }

  .index-list b {
    color: var(--coral);
  }

  @media (max-width: 760px) {
    body {
      overflow: auto;
    }

    .workspace {
      display: block;
    }

    .sidebar {
      position: sticky;
      top: 0;
      z-index: 10;
      width: 100%;
      height: auto;
      padding: 12px 14px;
      border-right: 0;
      border-bottom: 1px solid #d8dee4;
      flex-direction: row;
      align-items: center;
    }

    .brand-avatar {
      width: 34px;
      height: 34px;
    }

    .side-bottom {
      display: none;
    }

    .sidebar > div:first-child,
    .sidebar nav {
      display: flex;
      align-items: center;
    }

    .sidebar nav {
      margin: 0 0 0 18px;
    }

    .sidebar nav a {
      padding: 9px;
      font-size: 0;
    }

    .sidebar nav a span {
      font-size: 0.9rem;
    }

    .dashboard {
      height: auto;
      min-height: 100vh;
      overflow: visible;
      padding: 18px 14px;
      display: block;
    }

    .dashboard > * {
      margin-bottom: 18px;
    }

    .overview {
      grid-template-columns: 1fr;
    }

    .overview-art {
      display: none;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .project-card {
      min-height: 300px;
    }

    .index-list a {
      grid-template-columns: 30px 1fr 20px;
    }

    .index-list a span:nth-of-type(n + 2) {
      display: none;
    }
  }
</style>