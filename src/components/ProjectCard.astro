---
interface Project {
  id: string;
  data: {
    title: string;
    summary: string;
    year: string | number;
    type: string;
    tags: string[];
    accent?: string;
    cover?: string;
  };
}

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const {
  title,
  summary,
  year,
  type,
  tags,
  accent = '#aee4e6',
  cover,
} = project.data;
---

<article class="project-card">
  <a
    class="visual"
    href={`/projects/${project.id}/`}
    style={`--accent:${accent}`}
    aria-label={`查看项目：${title}`}
  >
    {
      cover ? (
        <img src={cover} alt={`${title}项目封面`} loading="lazy" />
      ) : (
        <div class:list={['art', `art-${(index % 3) + 1}`]}>
          <i class="shape one"></i>
          <i class="shape two"></i>
          <i class="shape three"></i>
          <span class="number">0{index + 1}</span>
        </div>
      )
    }

    <span class="open">查看作品 ↗</span>
  </a>

  <div class="meta-row">
    <span>{type}</span>
    <span>{year}</span>
  </div>

  <h3>
    <a href={`/projects/${project.id}/`}>{title}</a>
  </h3>

  <p>{summary}</p>

  <ul>
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>
</article>

<style>
  .project-card {
    min-width: 0;
  }

  .visual {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: 22px;
    background: var(--accent);
    box-shadow: 0 18px 36px rgba(25, 48, 57, 0.1);
  }

  .visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
  }

  .visual:hover img,
  .visual:hover .art {
    transform: scale(1.025);
  }

  .open {
    position: absolute;
    right: 18px;
    bottom: 18px;
    padding: 10px 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    font-size: 0.78rem;
    box-shadow: 0 8px 22px rgba(25, 48, 57, 0.13);
  }

  .art {
    position: absolute;
    inset: 0;
    transition: transform 0.45s ease;
  }

  .shape {
    position: absolute;
    display: block;
    background: var(--paper-warm);
    box-shadow: 12px 16px 24px rgba(25, 48, 57, 0.13);
  }

  .one {
    width: 36%;
    height: 54%;
    left: 20%;
    top: 20%;
    border-radius: 4px;
    transform: rotate(-5deg);
  }

  .two {
    width: 27%;
    aspect-ratio: 1;
    right: 15%;
    top: 20%;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 55%, white);
  }

  .three {
    width: 48%;
    height: 13%;
    right: 12%;
    bottom: 18%;
    border-radius: 4px;
    background: white;
  }

  .art-2 .one {
    width: 48%;
    height: 25%;
    left: 13%;
    top: 25%;
    transform: rotate(3deg);
  }

  .art-2 .two {
    right: 19%;
    top: 34%;
    background: var(--coral);
  }

  .art-2 .three {
    left: 19%;
    bottom: 16%;
    width: 26%;
    height: 26%;
    border-radius: 50% 50% 8px 8px;
  }

  .art-3 .one {
    width: 25%;
    height: 58%;
    left: 17%;
    top: 17%;
    transform: none;
    background: rgba(255, 255, 255, 0.7);
  }

  .art-3 .two {
    right: 17%;
    top: 18%;
    width: 37%;
    border-radius: 8px;
    background: white;
  }

  .art-3 .three {
    width: 56%;
    height: 9%;
    right: 12%;
    bottom: 20%;
    background: var(--blue);
  }

  .number {
    position: absolute;
    top: 18px;
    right: 20px;
    font: 700 0.75rem/1 var(--mono);
    color: rgba(25, 48, 57, 0.48);
  }

  .meta-row {
    margin-top: 20px;
    display: flex;
    justify-content: space-between;
    color: var(--ink-soft);
    font: 0.72rem/1 var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h3 {
    margin: 10px 0 7px;
    font-size: clamp(1.35rem, 2.3vw, 1.9rem);
    letter-spacing: -0.035em;
  }

  h3 a:hover {
    color: var(--blue-deep);
  }

  p {
    margin: 0;
    color: var(--ink-soft);
    line-height: 1.7;
    font-size: 0.9rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 15px 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 6px 9px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-soft);
    font: 0.67rem/1 var(--mono);
  }
</style>